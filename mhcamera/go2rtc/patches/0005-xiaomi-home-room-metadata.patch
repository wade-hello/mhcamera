+type catalogSource struct {
+	ID       string `json:"id"`
+	Name     string `json:"name"`
+	Model    string `json:"model"`
+	Info     string `json:"info"`
+	URL      string `json:"url"`
+	HomeID   string `json:"home_id"`
+	HomeName string `json:"home_name"`
+	RoomID   string `json:"room_id"`
+	RoomName string `json:"room_name"`
+}
+
+type catalogSnapshot struct {
+	Region  Region           `json:"region"`
+	Sources []*catalogSource `json:"sources"`
+}
+
+type catalogLoaderFunc func(context.Context, string, Region) (*catalogSnapshot, error)
+
+type deviceLocation struct {
+	homeID   xiaomiValue
+	homeName string
+	roomID   xiaomiValue
+	roomName string
+}
+
+type homeRecord struct {
+	name  string
+	rooms map[xiaomiValue]string
+}
+
+type locationBuilder struct {
+	ownerID   xiaomiValue
+	homes     map[xiaomiValue]*homeRecord
+	locations map[xiaomiValue]deviceLocation
+}
+
+func loadCloudCatalog(ctx context.Context, userID string, region Region) (*catalogSnapshot, error) {
+	return loadCatalog(ctx, userID, region, func(ctx context.Context, apiURL, params string) ([]byte, error) {
+		return cloudRequestContext(ctx, userID, string(region), apiURL, params)
+	})
+}
+
+func loadCatalog(ctx context.Context, userID string, region Region, request catalogRequestFunc) (*catalogSnapshot, error) {
+	if !isDecimalID(userID) {
+		return nil, fmt.Errorf("%w: account id", errCatalogIncomplete)
+	}
+	if parsed, err := parseRegion(string(region)); err != nil || parsed != region {
+		return nil, errInvalidRegion
+	}
+	devices, err := loadDevicePages(ctx, userID, request)
+	if err != nil {
+		return nil, err
+	}
+	locations := make(map[xiaomiValue]deviceLocation)
+	if len(devices) != 0 {
+		if loaded, loadErr := loadHomeRoomPages(ctx, userID, request); loadErr == nil {
+			locations = loaded
+		}
+	}
+
+	sources := make([]*catalogSource, 0, len(devices))
+	for _, device := range devices {
+		if !usableSourceHost(device.IP) {
+			continue
+		}
+		location := locations[device.Did]
+		sourceURL := &url.URL{
+			Scheme: "xiaomi",
+			User:   url.UserPassword(userID, string(region)),
+			Host:   device.IP,
+		}
+		query := sourceURL.Query()
+		query.Set("did", string(device.Did))
+		query.Set("model", device.Model)
+		sourceURL.RawQuery = query.Encode()
+		sources = append(sources, &catalogSource{
+			ID:       string(device.Did),
+			Name:     device.Name,
+			Model:    device.Model,
+			Info:     fmt.Sprintf("ip: %s, mac: %s", device.IP, device.MAC),
+			URL:      sourceURL.String(),
+			HomeID:   string(location.homeID),
+			HomeName: location.homeName,
+			RoomID:   string(location.roomID),
+			RoomName: location.roomName,
+		})
+	}
+	return &catalogSnapshot{Region: region, Sources: sources}, nil
+}
+
+// The plugin dials xiaomi://<user>:<region>@<host> and rejects anything that is
+// not a usable IPv4 address, so a cloud entry without one (offline or sleeping
+// devices report no localip) cannot become a selectable source. Keep it out of
+// the catalog instead of handing the plugin an entry it must discard.
+func usableSourceHost(host string) bool {
+	addr, err := netip.ParseAddr(host)
+	if err != nil || !addr.Is4() {
+		return false
+	}
+	value := addr.As4()
+	address := uint32(value[0])<<24 | uint32(value[1])<<16 | uint32(value[2])<<8 | uint32(value[3])
+	return address != 0 && address != 0xffffffff && value[0] != 127 && value[0] < 224
+}
+
+func loadHomeRoomPages(ctx context.Context, userID string, request catalogRequestFunc) (map[xiaomiValue]deviceLocation, error) {
+	if ctx == nil || !isDecimalID(userID) || request == nil {
+		return nil, errCatalogIncomplete
+	}
+	body, err := request(ctx, "/v2/homeroom/gethome", `{"limit":150,"fetch_share":true,"fetch_share_dev":true,"plat_form":0,"app_ver":9}`)
+	if err != nil {
+		return nil, err
+	}
+	var first struct {
+		HomeList         json.RawMessage `json:"homelist"`
+		ShareHomeListRaw json.RawMessage `json:"share_home_list"`
+		HasMore          bool            `json:"has_more"`
+		MaxID            json.RawMessage `json:"max_id"`
+	}
+	if err = json.Unmarshal(body, &first); err != nil {
+		return nil, fmt.Errorf("%w: home page", errCatalogIncomplete)
+	}
+	builder := &locationBuilder{
+		ownerID:   xiaomiValue(userID),
+		homes:     make(map[xiaomiValue]*homeRecord),
+		locations: make(map[xiaomiValue]deviceLocation),
+	}
+	builder.addHomes(catalogRawList(first.HomeList), false)
+	builder.addHomes(catalogRawList(first.ShareHomeListRaw), false)
+	if !first.HasMore {
+		return builder.snapshot(), nil
+	}
+
+	cursor, err := parseXiaomiValue(first.MaxID)
+	if err != nil || cursor == "" {
+		return nil, fmt.Errorf("%w: home cursor", errCatalogIncomplete)
+	}
+	seenCursors := map[xiaomiValue]struct{}{cursor: {}}
+	for {
+		if err = ctx.Err(); err != nil {
+			return nil, fmt.Errorf("%w: deadline", errCatalogIncomplete)
+		}
+		params, err := json.Marshal(struct {
+			StartID string `json:"start_id"`
+			Limit   int    `json:"limit"`
+		}{StartID: string(cursor), Limit: 150})
+		if err != nil {
+			return nil, fmt.Errorf("%w: home cursor", errCatalogIncomplete)
+		}
+		body, err = request(ctx, "/v2/homeroom/get_dev_room_page", string(params))
+		if err != nil {
+			return nil, err
+		}
+		var page struct {
+			Info    json.RawMessage `json:"info"`
+			HasMore bool            `json:"has_more"`
+			MaxID   json.RawMessage `json:"max_id"`
+		}
+		if err = json.Unmarshal(body, &page); err != nil {
+			return nil, fmt.Errorf("%w: home room page", errCatalogIncomplete)
+		}
+		builder.addHomes(catalogRawList(page.Info), true)
+		if !page.HasMore {
+			return builder.snapshot(), nil
+		}
+		next, parseErr := parseXiaomiValue(page.MaxID)
+		if parseErr != nil || next == "" {
+			return nil, fmt.Errorf("%w: home room cursor", errCatalogIncomplete)
+		}
+		if _, exists := seenCursors[next]; exists || next == cursor {
+			return nil, fmt.Errorf("%w: home room cursor did not advance", errCatalogIncomplete)
+		}
+		seenCursors[next] = struct{}{}
+		cursor = next
+	}
+}
+
+func catalogRawList(raw json.RawMessage) []json.RawMessage {
+	var entries []json.RawMessage
+	// Home and room metadata is optional. A missing, null, or malformed
+	// collection must not erase the valid entries in another collection.
+	_ = json.Unmarshal(raw, &entries)
+	return entries
+}
+
+func catalogValue(raw json.RawMessage) xiaomiValue {
+	value, err := parseXiaomiValue(raw)
+	if err != nil {
+		return ""
+	}
+	return value
+}
+
+func catalogName(raw json.RawMessage) string {
+	var name string
+	_ = json.Unmarshal(raw, &name)
+	return name
+}
+
+func catalogDIDs(raw json.RawMessage) []xiaomiValue {
+	entries := catalogRawList(raw)
+	dids := make([]xiaomiValue, 0, len(entries))
+	for _, entry := range entries {
+		if did := catalogValue(entry); did != "" {
+			dids = append(dids, did)
+		}
+	}
+	return dids
+}
+
+func (b *locationBuilder) addHomes(homes []json.RawMessage, allowOwnerlessKnownHomes bool) {
+	for _, raw := range homes {
+		var fields map[string]json.RawMessage
+		if json.Unmarshal(raw, &fields) != nil || fields == nil {
+			continue
+		}
+		ownerID, err := parseOwnerID(fields["uid"])
+		homeID := catalogValue(fields["id"])
+		ownerMatches := err == nil && ownerID == b.ownerID
+		// Follow-up pages can omit uid; accept only a home established by
+		// an earlier owner-verified entry, never an unknown or foreign home.
+		trustedKnownHome := err == nil && ownerID == "" && allowOwnerlessKnownHomes && homeID != "" && b.homes[homeID] != nil
+		if !ownerMatches && !trustedKnownHome {
+			continue
+		}
+		if homeID == "" {
+			continue
+		}
+		record := b.homes[homeID]
+		if record == nil {
+			record = &homeRecord{name: catalogName(fields["name"]), rooms: make(map[xiaomiValue]string)}
+			b.homes[homeID] = record
+		} else if record.name == "" {
+			record.name = catalogName(fields["name"])
+		}
+		for _, did := range catalogDIDs(fields["dids"]) {
+			b.addLocation(did, deviceLocation{homeID: homeID, homeName: record.name})
+		}
+		for _, roomRaw := range catalogRawList(fields["roomlist"]) {
+			var room map[string]json.RawMessage
+			if json.Unmarshal(roomRaw, &room) != nil || room == nil {
+				continue
+			}
+			roomID := catalogValue(room["id"])
+			if roomID == "" {
+				continue
+			}
+			if record.rooms[roomID] == "" {
+				record.rooms[roomID] = catalogName(room["name"])
+			}
+			for _, did := range catalogDIDs(room["dids"]) {
+				b.addLocation(did, deviceLocation{
+					homeID: homeID, homeName: record.name,
+					roomID: roomID, roomName: record.rooms[roomID],
+				})
+			}
+		}
+	}
+}
+
+func (b *locationBuilder) addLocation(did xiaomiValue, location deviceLocation) {
+	previous, exists := b.locations[did]
+	if !exists || (previous.homeID == location.homeID && previous.roomID == "" && location.roomID != "") {
+		b.locations[did] = location
+	}
+}
+
+func (b *locationBuilder) snapshot() map[xiaomiValue]deviceLocation {
+	result := make(map[xiaomiValue]deviceLocation, len(b.locations))
+	for did, location := range b.locations {
+		if home := b.homes[location.homeID]; home != nil {
+			location.homeName = home.name
+			location.roomName = home.rooms[location.roomID]
+		}
+		result[did] = location
+	}
+	return result
+}
