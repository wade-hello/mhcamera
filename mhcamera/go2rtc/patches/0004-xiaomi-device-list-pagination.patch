+const catalogRequestTimeout = 45 * time.Second
+
+var errCatalogIncomplete = errors.New("xiaomi: catalog incomplete")
+
+type catalogRequestFunc func(context.Context, string, string) ([]byte, error)
+
+func loadDevicePages(ctx context.Context, userID string, request catalogRequestFunc) ([]*Device, error) {
+	if ctx == nil || !isDecimalID(userID) || request == nil {
+		return nil, errCatalogIncomplete
+	}
+
+	ownerID := xiaomiValue(userID)
+	devices := make([]*Device, 0)
+	byDID := make(map[xiaomiValue]*Device)
+	seenCursors := make(map[xiaomiValue]struct{})
+	var cursor xiaomiValue
+
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, fmt.Errorf("%w: deadline", errCatalogIncomplete)
+		}
+
+		params := "{}"
+		if cursor != "" {
+			encoded, err := json.Marshal(struct {
+				StartDID string `json:"start_did"`
+			}{StartDID: string(cursor)})
+			if err != nil {
+				return nil, fmt.Errorf("%w: device cursor", errCatalogIncomplete)
+			}
+			params = string(encoded)
+		}
+		body, err := request(ctx, "/v2/home/device_list_page", params)
+		if err != nil {
+			return nil, err
+		}
+
+		var page struct {
+			List         json.RawMessage `json:"list"`
+			HasMore      bool            `json:"has_more"`
+			NextStartDID json.RawMessage `json:"next_start_did"`
+		}
+		if err = json.Unmarshal(body, &page); err != nil || len(page.List) == 0 {
+			return nil, fmt.Errorf("%w: device page", errCatalogIncomplete)
+		}
+
+		var pageDevices []*Device
+		if string(page.List) == "null" {
+			if page.HasMore {
+				return nil, fmt.Errorf("%w: non-terminal null device list", errCatalogIncomplete)
+			}
+			pageDevices = make([]*Device, 0)
+		} else if err = json.Unmarshal(page.List, &pageDevices); err != nil || pageDevices == nil {
+			return nil, fmt.Errorf("%w: device list", errCatalogIncomplete)
+		}
+
+		for _, device := range pageDevices {
+			if device == nil || device.Did == "" {
+				return nil, fmt.Errorf("%w: device", errCatalogIncomplete)
+			}
+			if !isCameraModel(device.Model) {
+				continue
+			}
+			if !isDecimalID(string(device.Did)) {
+				return nil, fmt.Errorf("%w: camera id", errCatalogIncomplete)
+			}
+			deviceOwnerID, parseErr := parseOwnerID(device.UID)
+			if parseErr != nil {
+				return nil, fmt.Errorf("%w: camera owner", errCatalogIncomplete)
+			}
+			if deviceOwnerID != ownerID {
+				continue
+			}
+			if previous := byDID[device.Did]; previous != nil {
+				if !sameDevice(previous, device) {
+					return nil, fmt.Errorf("%w: conflicting device", errCatalogIncomplete)
+				}
+				continue
+			}
+			byDID[device.Did] = device
+			devices = append(devices, device)
+		}
+
+		if !page.HasMore {
+			return devices, nil
+		}
+		next, err := parseXiaomiValue(page.NextStartDID)
+		if err != nil || next == "" {
+			return nil, fmt.Errorf("%w: device cursor", errCatalogIncomplete)
+		}
+		if _, exists := seenCursors[next]; exists || cursor != "" && next == cursor {
+			return nil, fmt.Errorf("%w: device cursor did not advance", errCatalogIncomplete)
+		}
+		seenCursors[next] = struct{}{}
+		cursor = next
+	}
+}
+
+func parseOwnerID(data json.RawMessage) (xiaomiValue, error) {
+	if len(data) == 0 || string(data) == "null" {
+		return "", nil
+	}
+	if data[0] == '"' {
+		var value string
+		if err := json.Unmarshal(data, &value); err != nil {
+			return "", errCatalogIncomplete
+		}
+		return xiaomiValue(value), nil
+	}
+	return parseXiaomiValue(data)
+}
+
+var cameraAllowlistWifispeaker = map[string]struct{}{
+	"xiaomi.wifispeaker.oh11": {},
+	"xiaomi.wifispeaker.x6a":  {},
+	"xiaomi.wifispeaker.x10a": {},
+	"xiaomi.wifispeaker.oh8":  {},
+	"xiaomi.wifispeaker.x8f":  {},
+}
+
+var cameraAllowlistController = map[string]struct{}{
+	"xiaomi.controller.oh10p": {},
+}
+
+func isCameraModel(model string) bool {
+	if strings.Contains(model, ".camera.") || strings.Contains(model, ".cateye.") {
+		return true
+	}
+
+	if _, ok := cameraAllowlistWifispeaker[model]; ok {
+		return true
+	}
+	if _, ok := cameraAllowlistController[model]; ok {
+		return true
+	}
+	return false
+}
+
+func sameDevice(a, b *Device) bool {
+	return a.Did == b.Did && a.Name == b.Name && a.Model == b.Model && a.MAC == b.MAC && a.IP == b.IP
+}
+
+type xiaomiValue string
+
+func (id *xiaomiValue) UnmarshalJSON(data []byte) error {
+	value, err := parseXiaomiValue(data)
+	if err != nil {
+		return err
+	}
+	*id = value
+	return nil
+}
+
+func parseXiaomiValue(data []byte) (xiaomiValue, error) {
+	if len(data) == 0 || string(data) == "null" {
+		return "", errCatalogIncomplete
+	}
+	var value string
+	if data[0] == '"' {
+		if err := json.Unmarshal(data, &value); err != nil {
+			return "", errCatalogIncomplete
+		}
+	} else {
+		value = string(data)
+	}
+	if value == "" {
+		return "", errCatalogIncomplete
+	}
+	if data[0] != '"' && !isDecimalID(value) {
+		return "", errCatalogIncomplete
+	}
+	return xiaomiValue(value), nil
+}
+
+func isDecimalID(value string) bool {
+	if value == "" {
+		return false
+	}
+	for _, digit := range value {
+		if digit < '0' || digit > '9' {
+			return false
+		}
+	}
+	return true
+}
+
 type Device struct {
-	Did   string `json:"did"`
-	Name  string `json:"name"`
-	Model string `json:"model"`
-	MAC   string `json:"mac"`
-	IP    string `json:"localip"`
+	Did   xiaomiValue     `json:"did"`
+	UID   json.RawMessage `json:"uid"`
+	Name  string          `json:"name"`
+	Model string          `json:"model"`
+	MAC   string          `json:"mac"`
+	IP    string          `json:"localip"`
 }
 
