+var errPhoneInput = errors.New("invalid phone input")
+
+const (
+	passportBaseURL       = "https://account.xiaomi.com"
+	passportSessionID     = "passport"
+	passportLocale        = "zh_CN"
+	passportCallback      = "https://account.xiaomi.com"
+	passportQS            = "%3Fsid%3Dpassport"
+	passportPhoneReferer  = "https://account.xiaomi.com/fe/service/login/phone"
+	passportUserAgent     = "Mozilla/5.0 (X11; Linux aarch64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"
+	phoneSessionLifetime  = 10 * time.Minute
+	passportResponseLimit = 1 << 20
+)
+
+var passportPolicyName = regexp.MustCompile(`window\.region="([A-Za-z0-9_-]+)"`)
+
+// The DER is the fixed Xiaomi web EUI encryption key used by the Passport page.
+const xiaomiEUIPublicKeyDER = "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCYEVrK/4Mahiv0pUJgTybx4J9P5dUT/Y0PuwMbk+gMU+jrZnBiXGv6/hCH1avIhoBcE535F8nJQQN3UavZdFkYidsoXuEnat3+eVTp3FslyhRwIBDF09v4vDhRtxFOT+R7uH7h/mzmyA2/+lfIMWGIrffXprYizbV76+YQKhoqFQIDAQAB"
+
+type phoneTokenAuthenticator func(userID, candidatePassToken string) (*xiaomicloud.Cloud, string, string, error)
+
+type phoneDependencies struct {
+	passportBase   string
+	transport      http.RoundTripper
+	randomDeviceID func() (string, error)
+	authenticate   phoneTokenAuthenticator
+	patchToken     func([]string, any) error
+	timeout        time.Duration
+}
+
+type phoneBootstrap struct {
+	mu sync.Mutex
+
+	passportBase   string
+	transport      http.RoundTripper
+	randomDeviceID func() (string, error)
+	authenticate   phoneTokenAuthenticator
+	patchToken     func([]string, any) error
+	timeout        time.Duration
+
+	session *phoneSession
+}
+
+type phoneSession struct {
+	client *http.Client
+	jar    http.CookieJar
+
+	deviceID       string
