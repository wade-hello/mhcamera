+// Both Xiaomi transports use the same immutable receive-track preparation.
+// The product exposes camera input only; no speaker/backchannel media or writer
+// interface is exported by this source.
+type preparedSource struct {
+	core.Producer
+	medias    []*core.Media
+	receivers []*core.Receiver
 }
 
+func prepareSource(source core.Producer, audioControl bool) (*preparedSource, error) {
+	p := &preparedSource{Producer: source}
+	for _, media := range source.GetMedias() {
+		if media.Direction != core.DirectionRecvonly {
+			continue
+		}
+		// Uncontrollable legacy cameras keep their existing upstream behavior,
+		// but do not advertise an audio track the product cannot mute.
+		if media.Kind == core.KindAudio && !audioControl {
+			continue
+		}
+		for _, codec := range media.Codecs {
+			if media.Kind == core.KindAudio && codec.Name != core.CodecPCMA && codec.Name != core.CodecOpus {
+				return nil, core.ErrNoAudio
+			}
+			track, err := source.GetTrack(media, codec)
+			if err != nil {
+				return nil, err
+			}
+			p.receivers = append(p.receivers, track)
+		}
+		p.medias = append(p.medias, media)
+	}
+	return p, nil
+}
+
+func (p *preparedSource) GetMedias() []*core.Media            { return p.medias }
+func (p *preparedSource) PreparedReceivers() []*core.Receiver { return p.receivers }
+func (p *preparedSource) GetTrack(media *core.Media, codec *core.Codec) (*core.Receiver, error) {
+	for _, track := range p.receivers {
+		if track.Media == media && track.Codec == codec {
+			return track, nil
+		}
+	}
+	return nil, core.ErrCantGetTrack
+}
