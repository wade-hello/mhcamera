diff --git a/pkg/tcp/udp_context.go b/pkg/tcp/udp_context.go
index e69de29..d5d4861 100644
--- a/pkg/tcp/udp_context.go
+++ b/pkg/tcp/udp_context.go
@@ -0,0 +1,29 @@
+package tcp
+
+import (
+	"context"
+	"net"
+	"strconv"
+	"strings"
+)
+
+// ResolveUDPContext supports a bare camera host or an explicit host:port without
+// leaving an uncancellable DNS operation ahead of the P2P socket owner.
+func ResolveUDPContext(ctx context.Context, address string, defaultPort int) (*net.UDPAddr, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		host, port = strings.Trim(address, "[]"), strconv.Itoa(defaultPort)
+	}
+	p, err := strconv.Atoi(port)
+	if err != nil || p < 0 || p > 65535 {
+		return nil, &net.AddrError{Err: "invalid UDP port", Addr: address}
+	}
+	ips, err := net.DefaultResolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	if len(ips) == 0 {
+		return nil, &net.AddrError{Err: "no IP address", Addr: address}
+	}
+	return &net.UDPAddr{IP: ips[0].IP, Zone: ips[0].Zone, Port: p}, nil
+}
