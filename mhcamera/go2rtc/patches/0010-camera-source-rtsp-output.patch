diff --git a/internal/camera/rtsp.go b/internal/camera/rtsp.go
index e69de29..895bb13 100644
--- a/internal/camera/rtsp.go
+++ b/internal/camera/rtsp.go
@@ -0,0 +1,282 @@
+package camera
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/internal/api"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/AlexxIT/go2rtc/pkg/rtsp"
+	"github.com/AlexxIT/go2rtc/pkg/tcp"
+)
+
+type rtspListenerState uint8
+
+const (
+	rtspServing rtspListenerState = iota
+	rtspClosing
+)
+
+type rtspSessionPhase uint8
+
+const (
+	rtspAccepted rtspSessionPhase = iota
+	rtspDescribed
+	rtspSetup
+	rtspPlaying
+)
+
+type rtspRun struct {
+	listener           net.Listener
+	source             *sourceOwner
+	username, password string
+	mu                 sync.Mutex
+	state              rtspListenerState
+	clients            map[net.Conn]struct{}
+	viewer             net.Conn // reserved only after authenticated DESCRIBE
+	wg                 sync.WaitGroup
+}
+
+type rtspControl struct {
+	mu      sync.Mutex // serializes listener/credential controls, never used by clients
+	address string
+	run     *rtspRun
+}
+
+func initRTSP() *rtspControl {
+	c := &rtspControl{address: ":8554"}
+	// The product owns this private endpoint; user YAML does not choose its API.
+	api.AllowPath("/api/camera/rtsp")
+	api.HandleFunc("api/camera/rtsp", c.handle)
+	return c
+}
+
+func (c *rtspControl) stop() {
+	if run := c.run; run != nil {
+		run.mu.Lock()
+		run.state = rtspClosing
+		_ = run.listener.Close()
+		for conn := range run.clients {
+			_ = conn.Close() // interrupt reads/writes without racing RTSP state fields
+		}
+		run.mu.Unlock()
+		run.wg.Wait() // all RTSP tracks detached before acknowledging disable
+		c.run = nil
+	}
+}
+
+func (c *rtspControl) configure(enabled bool, username, password string) error {
+	if !enabled {
+		c.stop()
+		return nil
+	}
+	if username != "viewer" || len(password) != 8 || strings.IndexFunc(password, func(r rune) bool { return !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9') }) >= 0 {
+		return errors.New("RTSP playback credentials are required")
+	}
+	if cameraSource == nil || cameraSource.snapshot().Source == "" {
+		return errors.New("selected camera has no source target")
+	}
+	if c.run != nil {
+		if c.run.username != username || c.run.password != password {
+			return errors.New("disable RTSP before changing credentials")
+		}
+		return nil
+	}
+	listener, err := net.Listen("tcp", c.address)
+	if err != nil {
+		return errors.New("RTSP port is unavailable")
+	}
+	run := &rtspRun{listener: listener, source: cameraSource, username: username,
+		password: password, clients: make(map[net.Conn]struct{})}
+	c.run = run
+	run.wg.Add(1)
+	go run.serve()
+	return nil
+}
+
+func (c *rtspControl) handle(w http.ResponseWriter, r *http.Request) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	switch r.Method {
+	case http.MethodPost:
+		var request struct {
+			Enabled  *bool  `json:"enabled"`
+			Username string `json:"username"`
+			Password string `json:"password"`
+		}
+		decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096))
+		decoder.DisallowUnknownFields()
+		if decoder.Decode(&request) != nil || request.Enabled == nil || decoder.Decode(new(any)) != io.EOF {
+			http.Error(w, "invalid RTSP configuration", http.StatusBadRequest)
+			return
+		}
+		if err := c.configure(*request.Enabled, request.Username, request.Password); err != nil {
+			http.Error(w, err.Error(), http.StatusConflict)
+			return
+		}
+	case http.MethodGet:
+	default:
+		w.Header().Set("Allow", "GET, POST")
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	clients := 0
+	if c.run != nil {
+		c.run.mu.Lock()
+		if c.run.viewer != nil {
+			clients = 1
+		}
+		c.run.mu.Unlock()
+	}
+	source := sourceSnapshot{State: sourceStopped}
+	if cameraSource != nil {
+		source = cameraSource.snapshot()
+	}
+	api.ResponseJSON(w, map[string]any{"enabled": c.run != nil, "port": 8554, "path": "/stream", "clients": clients,
+		"source": source.Source, "source_state": source.State, "source_error": source.Error, "audio_known": source.AudioKnown, "audio_supported": source.AudioSupported})
+}
+
+func (run *rtspRun) serve() {
+	defer run.wg.Done()
+	for {
+		conn, err := run.listener.Accept()
+		if err != nil {
+			return
+		}
+		run.mu.Lock()
+		if run.state == rtspClosing {
+			_ = conn.Close()
+			run.mu.Unlock()
+			return
+		}
+		// Bind the source generation before publishing this accepted client.
+		// No delayed playback goroutine may reserve a replacement source.
+		reservation, err := run.source.reserve(func() { _ = conn.Close() })
+		if err != nil {
+			_ = conn.Close()
+			run.mu.Unlock()
+			continue
+		}
+		run.clients[conn] = struct{}{}
+		run.wg.Add(1)
+		run.mu.Unlock()
+		go run.play(conn, reservation)
+	}
+}
+
+func (run *rtspRun) play(raw net.Conn, reservation *sourceLease) {
+	defer run.wg.Done()
+	defer func() {
+		_ = raw.Close()
+		run.mu.Lock()
+		delete(run.clients, raw)
+		if run.viewer == raw {
+			run.viewer = nil
+		}
+		run.mu.Unlock()
+	}()
+	conn := rtsp.NewServer(raw)
+	defer reservation.close()
+	conn.Auth(run.username, run.password) // localhost also requires authentication
+	conn.SessionName = "Mi Camera"
+	phase := rtspAccepted
+	handshakeDeadline := time.Now().Add(10 * time.Second)
+	conn.ServerHandshakeDeadline = handshakeDeadline
+	conn.ServerRequestPolicy = func(req *tcp.Request) string {
+		if run.source.snapshot().Generation != reservation.generation {
+			return "503 Service Unavailable"
+		}
+		if req.URL == nil || req.URL.RawQuery != "" || req.URL.Fragment != "" {
+			return "404 Not Found"
+		}
+		path := req.URL.Path
+		if req.Method == rtsp.MethodSetup {
+			id, err := strconv.Atoi(strings.TrimPrefix(path, "/stream/trackID="))
+			if err != nil || id < 0 || id >= len(conn.Senders) || path != "/stream/trackID="+strconv.Itoa(id) {
+				return "404 Not Found"
+			}
+		} else if path != "/stream" && !(req.Method == rtsp.MethodOptions && path == "*") {
+			return "404 Not Found"
+		}
+		switch req.Method {
+		case rtsp.MethodOptions, rtsp.MethodTeardown:
+			return ""
+		case "GET_PARAMETER":
+			if phase == rtspPlaying {
+				return ""
+			}
+		case rtsp.MethodDescribe:
+			if phase == rtspAccepted {
+				if run.source.snapshot().State != sourceRunning {
+					return "503 Service Unavailable"
+				}
+				run.mu.Lock()
+				defer run.mu.Unlock()
+				if run.state == rtspClosing {
+					return "503 Service Unavailable"
+				}
+				if run.viewer != nil {
+					return "453 Not Enough Bandwidth"
+				}
+				run.viewer = raw
+				return ""
+			}
+		case rtsp.MethodSetup:
+			if phase == rtspDescribed || phase == rtspSetup {
+				if strings.HasPrefix(req.Header.Get("Transport"), "RTP/AVP/TCP") {
+					phase = rtspSetup
+				}
+				return ""
+			}
+		case rtsp.MethodPlay:
+			if phase == rtspSetup {
+				phase = rtspPlaying
+				return ""
+			}
+		default:
+			return "405 Method Not Allowed"
+		}
+		return "455 Method Not Valid in This State"
+	}
+	attached := false
+	var lease *sourceLease
+	defer func() {
+		if attached {
+			lease.close()
+		} else {
+			_ = conn.Stop()
+		}
+		// Draining an already closed socket cannot block on network progress.
+		for _, sender := range conn.Senders {
+			sender.Wait()
+		}
+	}()
+	conn.Listen(func(msg any) {
+		if msg != rtsp.MethodDescribe {
+			return
+		}
+		phase = rtspDescribed
+		conn.Medias = []*core.Media{
+			{Kind: core.KindVideo, Direction: core.DirectionSendonly, Codecs: []*core.Codec{{Name: core.CodecH264}, {Name: core.CodecH265}}},
+			{Kind: core.KindAudio, Direction: core.DirectionSendonly, Codecs: []*core.Codec{{Name: core.CodecPCMA}, {Name: core.CodecOpus}}},
+		}
+		run.mu.Lock()
+		defer run.mu.Unlock()
+		if run.state == rtspServing {
+			var err error
+			lease, err = run.source.attach(reservation.generation, conn, true, func() { _ = raw.Close() })
+			attached = err == nil
+		}
+	})
+	if err := conn.Accept(); err == nil && attached && phase == rtspPlaying {
+		_ = conn.Handle()
+	}
+	_ = raw.Close()
+}
