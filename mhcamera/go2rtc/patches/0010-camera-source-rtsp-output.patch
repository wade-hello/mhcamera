diff --git a/internal/camera/source.go b/internal/camera/source.go
index e69de29..f48a789 100644
--- a/internal/camera/source.go
+++ b/internal/camera/source.go
@@ -0,0 +1,301 @@
+package camera
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi"
+)
+
+type sourceFactory func(context.Context, string, func(bool)) (core.PreparedProducer, error)
+type sourceState string
+
+const (
+	sourceStopped  sourceState = "stopped"
+	sourceStarting sourceState = "starting"
+	sourceRunning  sourceState = "running"
+	sourceRetrying sourceState = "retrying"
+	sourceStopping sourceState = "stopping"
+	sourceFailed   sourceState = "error"
+)
+
+type sourceFailure string
+
+const (
+	sourceDialFailed         sourceFailure = "source_dial_failed"
+	sourceReadFailed         sourceFailure = "source_read_failed"
+	sourceAudioUnavailable   sourceFailure = "audio_unavailable"
+	sourceCredentialRejected sourceFailure = "credential_rejected"
+)
+
+type sourceSnapshot struct {
+	Source         string         `json:"source"`
+	Generation     uint64         `json:"generation"`
+	State          sourceState    `json:"state"`
+	AudioKnown     bool           `json:"audio_known"`
+	AudioSupported bool           `json:"audio_supported"`
+	Error          *sourceFailure `json:"error"`
+}
+
+// One worker owns the complete resolve/dial/read/retry chain. Controls replace
+// only the latest target; an obsolete attempt must exit before another dials.
+type sourceOwner struct {
+	op       sync.Mutex
+	mu       sync.Mutex
+	status   sourceSnapshot
+	factory  sourceFactory
+	cancel   context.CancelFunc
+	producer core.PreparedProducer
+	leases   map[*sourceLease]struct{}
+	wake     chan struct{}
+	done     chan struct{}
+	closed   bool
+}
+type sourceLease struct {
+	owner          *sourceOwner
+	generation     uint64
+	consumer       core.Consumer
+	once           sync.Once
+	closeTransport func()
+}
+
+func newSourceOwner(factory sourceFactory) *sourceOwner {
+	o := &sourceOwner{factory: factory, status: sourceSnapshot{State: sourceStopped}, leases: make(map[*sourceLease]struct{}), wake: make(chan struct{}, 1), done: make(chan struct{})}
+	go o.worker()
+	return o
+}
+func (o *sourceOwner) snapshot() sourceSnapshot { o.mu.Lock(); defer o.mu.Unlock(); return o.status }
+func (o *sourceOwner) signal() {
+	select {
+	case o.wake <- struct{}{}:
+	default:
+	}
+}
+func (o *sourceOwner) set(source string) (sourceSnapshot, bool) {
+	o.op.Lock()
+	defer o.op.Unlock()
+	o.mu.Lock()
+	if o.status.Source == source || o.closed {
+		s := o.status
+		o.mu.Unlock()
+		return s, false
+	}
+	oldGeneration := o.status.Generation
+	o.status = sourceSnapshot{Source: source, Generation: oldGeneration + 1, State: sourceStarting}
+	if source == "" {
+		o.status.State = sourceStopping
+		if o.cancel == nil {
+			o.status.State = sourceStopped
+		}
+	}
+	if o.cancel != nil {
+		o.cancel()
+	}
+	o.producer = nil // closes the attach gate before retiring any track
+	leases := o.takeLeasesLocked(oldGeneration)
+	o.mu.Unlock()
+	for _, lease := range leases {
+		lease.close()
+	}
+	log.Info().Str("event", "camera_source_target").Uint64("generation", oldGeneration+1).Bool("enabled", source != "").Msg("camera source target accepted")
+	o.signal()
+	return o.snapshot(), true
+}
+func (o *sourceOwner) close() {
+	o.set("")
+	o.mu.Lock()
+	o.closed = true
+	if o.cancel != nil {
+		o.cancel()
+	}
+	o.mu.Unlock()
+	o.signal()
+	<-o.done
+}
+func (o *sourceOwner) takeLeasesLocked(generation uint64) []*sourceLease {
+	leases := make([]*sourceLease, 0, len(o.leases))
+	for lease := range o.leases {
+		if lease.generation == generation {
+			leases = append(leases, lease)
+			delete(o.leases, lease)
+		}
+	}
+	return leases
+}
+func (l *sourceLease) close() {
+	l.once.Do(func() {
+		if l.closeTransport != nil {
+			l.closeTransport()
+		}
+		if l.consumer != nil {
+			_ = l.consumer.Stop()
+		}
+	})
+	l.owner.mu.Lock()
+	delete(l.owner.leases, l)
+	l.owner.mu.Unlock()
+}
+func (o *sourceOwner) reserve(closeTransport func()) (*sourceLease, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.status.Source == "" {
+		return nil, errors.New("camera source has no target")
+	}
+	l := &sourceLease{owner: o, generation: o.status.Generation, closeTransport: closeTransport}
+	o.leases[l] = struct{}{}
+	return l, nil
+}
+
+func (o *sourceOwner) attach(generation uint64, cons core.Consumer, audio bool, closeTransport func()) (*sourceLease, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if generation != o.status.Generation || o.producer == nil || o.status.State != sourceRunning {
+		return nil, errors.New("camera source is not ready")
+	}
+	l := &sourceLease{owner: o, generation: generation, consumer: cons, closeTransport: closeTransport}
+	for _, track := range o.producer.PreparedReceivers() {
+		if track.Media.Kind == core.KindAudio && !audio {
+			continue
+		}
+		var media *core.Media
+		var codec *core.Codec
+		for _, candidate := range cons.GetMedias() {
+			if candidate.Direction != core.DirectionSendonly || candidate.Kind != track.Media.Kind {
+				continue
+			}
+			for _, c := range candidate.Codecs {
+				if track.Codec.Match(c) {
+					media, codec = candidate, c
+					break
+				}
+			}
+			if codec != nil {
+				break
+			}
+		}
+		if codec == nil {
+			return nil, errors.New("camera codec is not supported")
+		}
+		if err := cons.AddTrack(media, codec, track); err != nil {
+			return nil, err
+		}
+	}
+	o.leases[l] = struct{}{}
+	return l, nil
+}
+func (o *sourceOwner) worker() {
+	defer close(o.done)
+	for {
+		o.mu.Lock()
+		if o.closed {
+			o.mu.Unlock()
+			return
+		}
+		select {
+		case <-o.wake:
+		default:
+		}
+		source, generation := o.status.Source, o.status.Generation
+		if source == "" {
+			o.status.State = sourceStopped
+			o.cancel = nil
+			o.mu.Unlock()
+			<-o.wake
+			continue
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		o.cancel = cancel
+		o.status.State = sourceStarting
+		o.mu.Unlock()
+		p, err := o.factory(ctx, source, func(supported bool) {
+			o.mu.Lock()
+			if o.status.Generation == generation && ctx.Err() == nil {
+				o.status.AudioKnown = true
+				o.status.AudioSupported = supported
+			}
+			o.mu.Unlock()
+		})
+		var stopOnce sync.Once
+		stop := func() {
+			if p != nil {
+				stopOnce.Do(func() { _ = p.Stop() })
+			}
+		}
+		var stopCancellation func() bool
+		if p != nil {
+			stopCancellation = context.AfterFunc(ctx, stop)
+		}
+		reading := false
+		if err == nil {
+			o.mu.Lock()
+			if o.status.Generation == generation && ctx.Err() == nil {
+				o.producer = p
+				o.status.State = sourceRunning
+				o.status.Error = nil
+				reading = true
+			}
+			o.mu.Unlock()
+			if reading {
+				log.Info().Str("event", "camera_source_running").Uint64("generation", generation).Msg("camera source prepared")
+				err = p.Start()
+			}
+		}
+		o.mu.Lock()
+		current := o.status.Generation == generation && ctx.Err() == nil
+		if current {
+			o.producer = nil
+			o.status.State = sourceRetrying
+		}
+		leases := o.takeLeasesLocked(generation)
+		o.mu.Unlock()
+		for _, lease := range leases {
+			lease.close()
+		}
+		// Interrupt underlying socket/command I/O before invoking Stop. This
+		// also applies to read failures, not only explicit target cancellation.
+		cancel()
+		stop()
+		if stopCancellation != nil {
+			stopCancellation()
+		}
+		o.mu.Lock()
+		if o.status.Generation != generation {
+			o.cancel = nil
+			o.mu.Unlock()
+			continue
+		}
+		o.cancel = nil
+		key := sourceError(err, reading)
+		o.status.Error = &key
+		terminal := key == sourceCredentialRejected
+		if terminal {
+			o.status.State = sourceFailed
+		}
+		o.mu.Unlock()
+		log.Warn().Str("event", "camera_source_failed").Uint64("generation", generation).Str("reason", string(key)).Msg("camera source stopped")
+		if terminal {
+			<-o.wake
+		} else {
+			select {
+			case <-o.wake:
+			case <-time.After(time.Second):
+			}
+		}
+	}
+}
+func sourceError(err error, reading bool) sourceFailure {
+	var cloudErr *xiaomi.CloudError
+	if errors.As(err, &cloudErr) && cloudErr.Kind == xiaomi.CloudErrorCredentialRejected {
+		return sourceCredentialRejected
+	}
+	if errors.Is(err, core.ErrNoAudio) {
+		return sourceAudioUnavailable
+	}
+	if reading {
+		return sourceReadFailed
+	}
+	return sourceDialFailed
+}
diff --git a/internal/camera/source_api.go b/internal/camera/source_api.go
index e69de29..042c814 100644
--- a/internal/camera/source_api.go
+++ b/internal/camera/source_api.go
@@ -0,0 +1,66 @@
+package camera
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/url"
+
+	"github.com/AlexxIT/go2rtc/internal/api"
+)
+
+func (o *sourceOwner) handle(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	if r.URL.RawQuery != "" {
+		http.Error(w, "query is not supported", http.StatusBadRequest)
+		return
+	}
+	status := http.StatusOK
+	var snapshot sourceSnapshot
+	switch r.Method {
+	case http.MethodGet:
+		snapshot = o.snapshot()
+	case http.MethodPost:
+		var request struct {
+			Source string `json:"source"`
+		}
+		d := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096))
+		d.DisallowUnknownFields()
+		if d.Decode(&request) != nil || d.Decode(new(any)) != io.EOF {
+			http.Error(w, "invalid source target", http.StatusBadRequest)
+			return
+		}
+		u, err := url.Parse(request.Source)
+		if err != nil || u.Scheme != "xiaomi" || u.Host == "" || u.Fragment != "" {
+			http.Error(w, "invalid source target", http.StatusBadRequest)
+			return
+		}
+		var changed bool
+		snapshot, changed = o.set(request.Source)
+		if changed || snapshot.State != sourceRunning {
+			status = http.StatusAccepted
+		}
+	case http.MethodDelete:
+		var b [1]byte
+		if n, _ := r.Body.Read(b[:]); n != 0 {
+			http.Error(w, "DELETE body is not supported", http.StatusBadRequest)
+			return
+		}
+		snapshot, _ = o.set("")
+		if snapshot.State != sourceStopped {
+			status = http.StatusAccepted
+		}
+	default:
+		w.Header().Set("Allow", "GET, POST, DELETE")
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(snapshot)
+}
+
+func initSourceAPI(o *sourceOwner) {
+	api.AllowPath("/api/camera/source")
+	api.HandleFunc("api/camera/source", o.handle)
+}
