+func writeCatalogError(w http.ResponseWriter, err error) {
+	status := http.StatusBadGateway
+	response := catalogErrorResponse{
+		State:      "error",
+		ErrorKind:  xiaomi.CloudErrorUnknown,
+		MessageKey: "xiaomi_request_failed",
+	}
+
+	switch {
+	case errors.Is(err, errInvalidRegion):
+		status = http.StatusBadRequest
+		response.ErrorKind = xiaomi.CloudErrorProtocol
+		response.MessageKey = "invalid_region"
+	case errors.Is(err, errInvalidCatalogRequest):
+		status = http.StatusBadRequest
+		response.ErrorKind = xiaomi.CloudErrorProtocol
+		response.MessageKey = "invalid_request"
+	case errors.Is(err, errCatalogIncomplete):
+		response.ErrorKind = xiaomi.CloudErrorProtocol
+		response.MessageKey = "catalog_incomplete"
+	default:
+		var cloudErr *xiaomi.CloudError
+		if errors.As(err, &cloudErr) {
+			response.ErrorKind = cloudErr.Kind
+			response.RequestStageCode = cloudErr.RequestStageCode
+			if cloudErr.Kind == xiaomi.CloudErrorNetwork {
+				response.NetworkReasonCode = cloudErr.NetworkReasonCode
+			}
+			if cloudErr.Kind == xiaomi.CloudErrorCredentialRejected {
+				status = http.StatusUnauthorized
+				response.MessageKey = "xiaomi_reauthorization_required"
+				response.ReasonCode = authReasonPassTokenRejected
+			}
+		}
+	}
+
+	w.Header().Set("Content-Type", api.MimeJSON)
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(response)
+}
