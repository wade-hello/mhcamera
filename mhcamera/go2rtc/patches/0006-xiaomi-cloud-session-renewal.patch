diff --git a/pkg/xiaomi/cloud_diagnostics.go b/pkg/xiaomi/cloud_diagnostics.go
index e69de29..f234d6b 100644
--- a/pkg/xiaomi/cloud_diagnostics.go
+++ b/pkg/xiaomi/cloud_diagnostics.go
@@ -0,0 +1,93 @@
+package xiaomi
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"io"
+	"net"
+	"syscall"
+)
+
+type RequestStage uint8
+
+const (
+	RequestStageUnknown RequestStage = iota
+	RequestStageTokenLogin
+	RequestStageTokenFinish
+	RequestStageCloudAPI
+	// Stage 4 is reserved for the product's local Unix RPC caller.
+)
+
+type NetworkReason uint8
+
+const (
+	NetworkReasonUnknown NetworkReason = iota
+	NetworkReasonDNS
+	NetworkReasonConnect
+	NetworkReasonTimeout
+	NetworkReasonTLSCertificate
+	NetworkReasonTLSHandshake
+	NetworkReasonCancelled
+	NetworkReasonIO
+)
+
+// Only typed causes and operation metadata are diagnostic evidence. Unknown
+// errors stay unknown; neither error text nor URLs are inspected or exported.
+func classifyNetworkError(err error) NetworkReason {
+	if errors.Is(err, context.Canceled) {
+		return NetworkReasonCancelled
+	}
+	if errors.Is(err, context.DeadlineExceeded) || networkTimeout(err) {
+		return NetworkReasonTimeout
+	}
+	var dns *net.DNSError
+	if errors.As(err, &dns) {
+		return NetworkReasonDNS
+	}
+	var certificate *tls.CertificateVerificationError
+	var authority x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var invalid x509.CertificateInvalidError
+	var roots x509.SystemRootsError
+	if errors.As(err, &certificate) || errors.As(err, &authority) || errors.As(err, &hostname) || errors.As(err, &invalid) || errors.As(err, &roots) {
+		return NetworkReasonTLSCertificate
+	}
+	var record tls.RecordHeaderError
+	var alert tls.AlertError
+	if errors.As(err, &record) || errors.As(err, &alert) {
+		return NetworkReasonTLSHandshake
+	}
+	var operation *net.OpError
+	if errors.As(err, &operation) && operation.Op == "dial" {
+		return NetworkReasonConnect
+	}
+	if errors.Is(err, syscall.ECONNREFUSED) || errors.Is(err, syscall.ENETUNREACH) || errors.Is(err, syscall.EHOSTUNREACH) {
+		return NetworkReasonConnect
+	}
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) || errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE) || (operation != nil && (operation.Op == "read" || operation.Op == "write")) {
+		return NetworkReasonIO
+	}
+	return NetworkReasonUnknown
+}
+
+// A url.Error can implement Timeout yet return false when a wrapping error
+// hides its inner net.Error. Inspect the chain, not just its first net.Error.
+func networkTimeout(err error) bool {
+	if network, ok := err.(net.Error); ok && network.Timeout() {
+		return true
+	}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		for _, cause := range joined.Unwrap() {
+			if networkTimeout(cause) {
+				return true
+			}
+		}
+		return false
+	}
+	if cause := errors.Unwrap(err); cause != nil {
+		return networkTimeout(cause)
+	}
+	return false
+}
